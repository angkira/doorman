# doorman Configuration

[daemon]
# SYSTEM-mode command socket. Lives under /run/doorman/ (systemd
# RuntimeDirectory=doorma - Detect﻿   YuNet (face_detection_yunet_2023mar.onnx), 640x640, MIT
