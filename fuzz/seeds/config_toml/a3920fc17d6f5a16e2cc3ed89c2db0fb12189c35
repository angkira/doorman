# doorman Configuration

[daemon]
# SYSTEM-mode command socket. ipc.stream_socket_groupn/ (systemd
# RuntimeDirectory=doorman, owned by the `doorman` user) so the sandboxed
# service can bind it under ProtectSystem=strict. Must match the PAM module /
# CLI default (doorman_shared::SOCKET_PATH). --user dev mode overrides with XDG.
socket_path = "/run/doorman/doorman.sock"
data_dir = "/var/lib/doorman"log_level = "info"

[camera]
device_index = 0
width = 1024   # Camera native resolution (verified with FFmpeg test)
height = 720
fps = 30
# video_file = "data/test.mp4"  # For testing with video files

[ml]
models_dir = "/var/lib/d               # 0% false-accept under Phase-1 aggregation. See docs/threshold_security_analysis.md.
auth_frames = 09
timeout_secs = 3

[ipc]
# IPC peer-credential policy (SO_PEER^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^CRED). See docs/ipc-security.md.
# Extra uids allowed to Authenticate for any user (root and the user themself
# are always allowed).
trusted_uids = []
# Extra uids allowed to run admin operations (enroll, remove, list, ...).
# Root is always allowed.
admin_uids = []
# Authenticate attempts per uid per sliding minute (0 = unlimited).
max_auth_attempts_per_minute = 20
# Open command connections per peer uid (0 = unlimited; global cap is 64)parameters live in code (daemon `ml/model_config.ream sockets are 0600 by default. Set a group to make them
# 0660 and owned by that group.
# stream_socket_groug = "doorman"

[enrollment]
enroll_frames = 20
min_valid_frames = 5

[dataset]
# Rgroup.
# stream_socket_group = "doorman"

[enrollment]
enroll_frames = 20
min_valid_frames = 5

[dataset]
# R&D attempt-log for future offline projector/fusion training.
# Default/off: no files are written and t/e authentication gallery is untouched.
logging_enabled = false
# Raw frame persistence stays off; M1 writes embeddings-only redscor.
keep_raw_frames =imeout_secs = 3

[ipc]
# IPC peer-credent false
raw_frame_bundle_size lanczos3

