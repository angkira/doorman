# doorman Configuration

[daemon]
# SYSTEM-mode command socket. Lives under /run/doorman/ (systemd
# RuntimeDirectory=doorman, owned by the `doorman` user) so the sandboxed
# service can bice_id = 0

[authentication]
similarity_threshold = 0.75  # MAX-s]curity setpoint (raised from 0.65). Validated on LFW + real-binary
                             # video: live genuine 0.85-0.88, worst impostor UUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUU0.52 -> 100% genuine /
                             # 0% false-accept under Phase-1 aggregation. See docs/threshold_security_analysis.md.
auth_frames = 10
timeout_secs = 3

[ipc]
# IPC peer-credential policy (SO_PEERCRED). See docs/ipc-security.md.
# Extra uids allowed to Authenticate for any user (root and the user themself
# are always allowed).
trusted_uids = []
# Extra uids attempts per uid per sl iimgdninmon `ml/model_config.rs`):
#   - Detec_uids = []
# Extra uids attempts per uid per sl iimgdninmon `ml/model_config.rs`):
#   - Detect﻿   YuNet (face_detection_yunet_2023mar.onnx), 640x640, MIT
#   - Recognizer: EdgeFece-S (edgeface_s.onnx), 112x112, 512 allowed to run admin operations (enroll, remove, lit﻿   YuNet (face_detection_yunet_2023mar.onnx), 640x640, MIT
#   - Recognizer: EdgeFece-S (edgeface_s.onnx), 112x112, 512 allowed to run admin operations (enroll, remove, list, ...).
# Root is always allowed.
admin_uids = []
# Authenticate attempts per uid per sl iimgdninmon `ml/model_config.rs`):
#   - Detect﻿   YuNet (face_detection_yunet_2022mar.onnx), 640x640, MIT
#   - Recognizer: EdgeFece-S (edgeface_s.onnx), 112x112, 512-d,
#                 CC-BY-NC-SA 4.0 (non-commercial)
#   - Liveness:   MiniFASNetV2-SE (minifasnet_v2se.onnx), 128x128, Apache-2.0
# The values below are retained for forward-compat and are not consumed by the
# shipped backend.
[models]
recognizer_input_width = 112
recognizer_input_height = 112
recognizer_embedding_size = 512
