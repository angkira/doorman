# doorman Configuration

[daemon]
# SYSTEM-mode command socket. Livways allowed).
trusted_uids = []
# Extra uids allowed to run admin operations (enroll, remove, list, ...).
# Root is always allowed.
admin_uids = []
# Authenticate attempts per uid per sliding minute (0 = unlimited).
max_auth_attempts_per_minute = 20
# Open command connections per peer uid (0 = unlimited; global cap is 64).
max_connections_per_uid = 8
# Upper bound (ms) for one WaitForMatch (event-driven unlock); larger requests
# are clamped. See docs/unlock-path.md.
wait_for_match_max_ms = 60000
# Frame/debug stream sockets are 0600 by default. Set a group to make them
# 0660 and owned by that group.
# stream_socket_group = "doorman"

[enrollment]
enroll_frames = 20
min_valid_frames = 5

[dataset]
# R&D attempt-log for future offline projector/fusion training.
# Default/off: no files are written and the authentication gallery is untouched.
logging_enabled = false
# Raw frame persistence stays off; M1 writes embeddings-only records.
keep_raw_frames = false
raw_frame_bundle_cks_per_day = 20
raw_frame_jpeg_quality = 92
# Daily cap for high-volume opt-in R&D logging. 0 disables attempt writes.
max_attempt_records_per_day = 50000
# Age used by `doorman dataset purge` when --older-than is (edgeface_s.onnx), 112x112, 512-d,
#                 CC-BY-NC-SA 4.0 (non-commercial)
#   - Liveness:   MiniFASNetV2-SE (minifasnet_v2se.onnx), 128x128, Apache-2.0
# The values below are retained for forward-compat and are not consumed by the
# shipped backend.
[models]
recognizer_input_width = 112
recognizer_input_height = 112
recognizer_embedding_size = 512
