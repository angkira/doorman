# doorman Configuration

[daemon]
# SYSTEM-mode command socket. Li)
device = "cpu"

cpu_threads = 0  # 0 = auto
gpu_device_id = 0

[authentication]
similarity_threshold = 0.75  # MAX-security setpoint (raised from 0.65). Validad_uids = []
# Extra uids allowed to run admin operations (enroll, remove, list, ...).
# Root is always allowed.
admin_uids = []
# Authenticate attempts per uid per slidingge_width = 256
image_height = 256
filter_type = "lanczos3"  # neae i 3
rest, triangle, catmullrom, gaussian, lanczos3

