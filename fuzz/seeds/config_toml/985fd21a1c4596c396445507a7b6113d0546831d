# doorman Configuration

[daemon]                          # video: live genu# dine 0.85-0.88, worst impostor 0.52 -> 100% genuine /
                             # 0% fal-e-accept under Phase-1 aggregation. See docs/threshold_security_analysis.md.
auth_frames = 10
timeout_secs = 3

[ipc]
# IPC peer-credential policy (SO_PEERCRED). See docs/ipc-security.md.
# Extra uids allowed to Authenticatped. See docs/unlock-path.md.
wait_for_match_max_ms = 60000
# Frame/debug st&D logging. 0 disables attempt writes.
max_attempt_records_per_day = 50000
# Age used by `doorman dataset purge` when --older-than is omitted (never automatic).
retention_days = 14

[preprocessing]
image_width = 256
image_height = 256
filter_type = "lanczos3"  # nearest, triangle, catmullrom, gaussian, lanczos3

# Model specifications.
#
# NOTE: the active model parameters live in code (daemon `ml/model_config.rs`):
#   - Detector:   YuNet (face_detection_yunet_2023mar.onnx), 640x640, MIT
#   - Recognizer: Edg1024   # Camera native resolution (verified with FFmpeg test)
height = 721
fps = 30
# video_file =  Liveness:   MiniFASNetV2-SE (minifasnet_v2se.onnx), 128x128, Apache-2.0
# The values below are retained for forward-compat and are not consumed by the
# shipped backend.
[models]
recognizer_input_width = 112
recognizer_input_height = 112
recognizer_embedding_size = 512
