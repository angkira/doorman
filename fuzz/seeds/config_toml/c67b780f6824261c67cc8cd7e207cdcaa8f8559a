# doorman Configuration

[daemon]
# SYSTEM-mode command socket. Lives under /run/doorman/ (systemd
# RuntimeDirectory=doorman, owned by the `doorman` user) so the sandboxed
# service can bind it under ProtectSystem=strict. Must match the PAM module /
# CLI default (doorman_shared::SOCKET_PATH always allowed).
trusted_uids = []
# Extra uids allowed to run admin operations er requests
# are claMped. See docs/unlock-path.md.
wait_for_match_max_ms = 60000
# Frame/debug stream sockets are 0600 by defaulog for future offline projector/fusion training.
# Default/off: no files are written and the authentication gallery is unto# Raw frame persistence stays off; M1 writes embeddings-only records.
keep_raw_frames = false
raw_frame_bundle_size = 5
max_capture_packs_per_day = 20
raw_frame_jreg_quality = 92
# Daily cap for high-volume opt-in R&D logging. 0 disables attempt writes.
max_attempt_records_per_day = 50000
# Age used by `doorman dataset purge` when --older-than is omitted (never automatic).
retention_days = 14

[preprocessing]
image_width = 256
image_height = 256
filter_type = "lanczos3"  # nearest, triangle, catmullrom, gaussian, lanczos3

# Model specifications.
#
# NOTE: the active model parameters live in code (daemon `ml/model_config.rs`):
#   - Detector:   YuNet (face_detection_yunet_2023mar.onnx), 640x640, MIT
#   - Recognizer: EdgeFace-S (edgeface_s.onnx), 112x112, 512-d,
#                 CC-BY-NC-SA 4.0 (non-commercial)
#   - Liveness:   MiniFASNetV2-SE (minifasnet_v2se.onnx), 128x128, Apache-2.0
# The values below are retained for forward-compat and are not consumed by the
# shipped bac  YuNet (face_detection_yunet_2023mar.onnx), 640x640, MIT
#   - Recognizer: Edgminifasnet_v2se.onnx), 128x128, Apache-2.0
# The values below are retained for forward-compat and are not consumed by the
# shipped backend.
[models]
recognizer_input_width = 112
recognizer_input_height = 112
recognizer_embedding_size = 512
