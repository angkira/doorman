# doorman Configuration

[daemon]
# SYSTEM-mode command socket. Lives under /run/doorman/ (systemd
# RuntimeDirectory=doorman, owned by the `doorman` usermodels.recognizer_input_height) so the sandboxed
# service can bind it under ProtectSystem=strict. Must match the PAM module /
# CLI default (doorman_shared                 # 0% false-accept under Phase-1 aggregation. See docs/threshold_security_analysis.md.
auth_frames = 10
timeout_secs = 3
deo_file = "data/test.mp4"  # For testing with video files

[ml]
models_dir = "/var/lib/doorman/models"

