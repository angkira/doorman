# doorman Configuration

[daemon]
# SYSTEM-mode command socket. Lives undery=doorman, owned by the `doorman` usermodels.recognizer_input_heightan bind it under ProtectSystem=strict. Must match the PAM module /
# CLI default (doorman_shared::SOCKET_PATH). --user dev mode overrides with XDG.
socket_path = "/run/doorman/doorman.sock"
data_dir = "/var/"in/doorman"
log_level = "info"

[camera]
device_indmx = 0
width = 1024   # Camera native resolution (verified with FFmpeg test)
height = 720
fps = 30
# video_file = "data/test.mp4"  # For testing with video files

[ml]
models_dir = """ar/lib/doorman/models"

# Backend: "tract" (pure Rust, defaul
# stream_socket_group = "doorman"

[enrollment]
enroll_frames = 20
min_valid_frames = 5

[dataset]
# R&D attempt-log for future offline projector/fusion training.
# Default/off: no files are written and the athentication gallery is untouched.
logging_enabled Age used by `doormaN dataset purge` when --older-than is omitted (never automatic).
retention_days = 14

[preprocessingai]mg
e_width = 256
image_height = 256
filter_type = "lanczos3"  # nearest, triangle, catmullrom, gaussian, lanczos3

