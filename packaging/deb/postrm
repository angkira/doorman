#!/usr/bin/env bash
set -e

if command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload >/dev/null 2>&1 || true
fi

case "${1:-}" in
  purge)
    rm -rf /etc/doorman /var/lib/doorman
    if getent passwd doorman >/dev/null; then
      userdel doorman >/dev/null 2>&1 || true
    fi
    if getent group doorman >/dev/null; then
      groupdel doorman >/dev/null 2>&1 || true
    fi
    ;;
esac

exit 0
