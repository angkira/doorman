# doorman daemon configuration (system service).
#
# Installed to /etc/doorman/doorman.toml by `make install` if no config exists.
# All keys are optional; omitted keys fall back to the documented defaults.

[daemon]
socket_path = "/run/doorman/doorman.sock"
data_dir    = "/var/lib/doorman"
log_level   = "info"
# Real deployment: boot LOCKED and clear the lock only on a recognized face.
# The background recognition loop processes frames while locked. PAM
# authentication runs an on-demand face check regardless of this flag.
start_locked = true
# Leave false for the system service; only the dev/preview build streams frames.
preview_mode = false
debug_mode   = false

[camera]
# V4L2 device index (/dev/video0 -> 0). The lean Linux build uses the
# camera-v4l2 or camera-gstreamer backend selected at compile time.
device_index = 0
# Pin the physical camera by a stable node instead of the index, e.g.
# device_path = "/dev/v4l/by-id/usb-Vendor_Camera-video-index0"
# Virtual devices (v4l2loopback, vivid) are refused unless this is true;
# keep it false in production.
allow_virtual_devices = false
width  = 1280
height = 720
fps    = 30
# "auto" = native V4L2 (accepted only after a real first frame), then ffmpeg.
# "ffmpeg" skips the native backend; "native" disables the ffmpeg fallback.
backend = "auto"
# Native backend: buffers dropped after STREAMON before a frame may count (0..=10).
# native_warmup_frames = 3
# After a native failure, go straight to ffmpeg for this many seconds (0 = off).
# native_failure_cooldown_secs = 600

[ml]
backend    = "ort"
device     = "cpu"            # "rocm" / "cuda" only with the matching feature build
models_dir = "/var/lib/doorman/models"
cpu_threads = 0              # 0 = let ONNX Runtime pick

[authentication]
# Cosine-similarity match threshold for EdgeFace-S (see shared/src/lib.rs).
similarity_threshold = 0.4
auth_frames          = 10
timeout_secs         = 3     # must stay <= the PAM hard timeout
# MiniFASNet liveness is a convenience deterrent; non-fatal when it fails.
liveness_enabled     = true

[recognition]
# Keep this explicit for wide-angle/4K webcams where the face occupies a smaller
# fraction of the frame. The daemon default is intentionally stricter.
aggregation_window   = 5
hysteresis_frames    = 3
min_sharpness        = 8.0
min_face_area_frac   = 0.005

[dataset]
# Off by default for packaged installs. When enabled for local R&D, auth attempts
# persist detector-positive raw face frames before recognition, capped here.
logging_enabled = false
keep_raw_frames = false
raw_frame_bundle_size = 5
max_capture_packs_per_day = 20
raw_frame_jpeg_quality = 92
max_attempt_records_per_day = 50000
# Age used by `doorman dataset purge` when --older-than is omitted (never automatic).
retention_days = 14

[ipc]
# Face unlock waiting (docs/unlock-path.md). Pre-arm starts the camera and the
# full recognition when the unlock helper asks, in parallel with the compositor
# finishing the lock. The result is still delivered only after the session is
# reported locked, and only from frames captured after the request. This changes
# timing, not the decision. Set false to keep the camera off until locked.
# prearm_camera = true
# Longest the camera is held without the lock being confirmed (1..=30 s).
# prearm_max_hold_secs = 5
